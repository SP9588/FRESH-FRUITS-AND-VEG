rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Helpers
    function isSignedIn() { return request.auth != null; }
    function isVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isAdmin() { 
      return isSignedIn() && (
        request.auth.token.email == 'santoshprasad8891@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      ); 
    }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // --- Entity Validations ---

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role']) &&
             data.uid == request.auth.uid &&
             data.email is string &&
             data.role in ['customer', 'seller', 'admin'];
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['name', 'sellerId', 'price', 'category']) &&
             data.name is string && data.name.size() <= 100 &&
             data.category is string &&
             data.price is number && data.price > 0 &&
             data.sellerId == request.auth.uid;
    }

    function isValidNotification(data) {
      return data.keys().hasAll(['userId', 'title', 'message', 'type']) &&
             data.userId is string &&
             data.title is string &&
             data.message is string &&
             data.type is string;
    }

    // --- Match Blocks ---

    // 1. Users Collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if (isVerified() || isSignedIn()) && isValidUser(incoming()) && isValidId(userId);
      allow update: if isSignedIn() && (isOwner(userId) || isAdmin());
    }

    // 2. Sellers Collection
    match /sellers/{sellerId} {
      allow read: if isSignedIn();
      allow create: if (isVerified() || isSignedIn()) && isOwner(sellerId) && isValidId(sellerId);
      allow update: if isSignedIn() && (isOwner(sellerId) || isAdmin());
    }

    // 3. Products Collection
    match /products/{productId} {
      allow read: if true; // Public marketplace
      allow create: if isSignedIn() && isValidProduct(incoming()) && isValidId(productId);
      allow update: if (
                      isSignedIn() && (existing().sellerId == request.auth.uid || isAdmin()) && 
                      incoming().diff(existing()).affectedKeys().hasAny(['name', 'price', 'discountPrice', 'stock', 'status', 'description', 'lowStockThreshold', 'rating', 'reviewCount', 'updatedAt'])
                    ) || (
                      // Allow customers to decrement stock during purchase
                      isSignedIn() && incoming().diff(existing()).affectedKeys().hasOnly(['stock', 'status']) && 
                      incoming().stock <= existing().stock
                    ) || (
                      // Allow logged in customers to update rating & reviewCount when reviewing
                      isSignedIn() && incoming().diff(existing()).affectedKeys().hasAny(['rating', 'reviewCount'])
                    );
      allow delete: if isSignedIn() && (resource.data.sellerId == request.auth.uid || isAdmin());
    }

    // 3b. Reviews Collection
    match /reviews/{reviewId} {
      allow read: if true; // Anyone can read reviews
      allow create: if isSignedIn() && incoming().userId == request.auth.uid && isValidId(reviewId);
      allow update: if isSignedIn() && (
                      (existing().userId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasAny(['rating', 'comment', 'freshnessRating', 'packagingRating', 'tasteRating', 'images', 'updatedAt'])) ||
                      (incoming().diff(existing()).affectedKeys().hasAny(['helpfulCount', 'helpfulUsers'])) ||
                      (incoming().diff(existing()).affectedKeys().hasOnly(['sellerReply']))
                    );
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // 4. Orders Collection
    match /orders/{orderId} {
      allow get: if isSignedIn() && (resource.data.customerId == request.auth.uid || resource.data.sellerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn();
      allow create: if isSignedIn() && incoming().customerId == request.auth.uid && isValidId(orderId);
      allow update: if isSignedIn() && (resource.data.sellerId == request.auth.uid || resource.data.customerId == request.auth.uid || isAdmin());
    }

    // 5. Notifications Collection
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidNotification(incoming()) && isValidId(notificationId);
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['read']);
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // 6. Crop Diagnostics Collection
    match /cropDiagnostics/{diagnosticId} {
      allow read: if isSignedIn() && (resource.data.sellerId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && incoming().sellerId == request.auth.uid;
      allow delete: if isSignedIn() && (resource.data.sellerId == request.auth.uid || isAdmin());
    }

    // 7. Settings Collection
    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 8. Subscription Plans (Catalog)
    match /subscriptionPlans/{planId} {
      allow read: if true; // Public catalog for visitors and customers
      allow create, update, delete: if isAdmin();
    }

    // 9. Customer Subscriptions
    match /customerSubscriptions/{subscriptionId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn();
      allow create: if isSignedIn() && incoming().userId == request.auth.uid && isValidId(subscriptionId);
      allow update: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // 10. Subscription Payments Ledger
    match /subscriptionPayments/{paymentId} {
      allow get: if isSignedIn() && (resource.data.customerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn();
      allow create: if isSignedIn() && incoming().customerId == request.auth.uid && isValidId(paymentId);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // 11. Subscription Email Templates
    match /subscriptionTemplates/{templateId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 12. Subscription Coupons
    match /subscriptionCoupons/{couponId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 13. Subscription Audit Logs
    match /subscriptionAuditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }
  }
}
