{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Base user profile for customers and sellers.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["customer", "seller", "admin"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role"]
    },
    "Seller": {
      "title": "Seller Profile",
      "description": "Extended profile for registered sellers.",
      "type": "object",
      "properties": {
        "businessName": { "type": "string" },
        "farmName": { "type": "string" },
        "type": { "type": "string", "enum": ["Farmer", "Retailer", "Wholesaler", "Organic Producer", "Exporter", "Distributor"] },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "whatsapp": { "type": "string" },
        "country": { "type": "string" },
        "isoCode": { "type": "string" },
        "stdCode": { "type": "string" },
        "postalCode": { "type": "string" },
        "state": { "type": "string" },
        "city": { "type": "string" },
        "address": { "type": "string" },
        "verified": { "boolean": "boolean" },
        "commissionRate": { "type": "number" },
        "location": {
          "type": "object",
          "properties": {
            "lat": { "type": "number" },
            "lng": { "type": "number" }
          }
        },
        "documents": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "Product": {
      "title": "Marketplace Product",
      "description": "Fruits and vegetables listed by sellers.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "discountPrice": { "type": "number" },
        "unit": { "type": "string", "enum": ["kg", "unit", "box", "g"] },
        "stock": { "type": "number" },
        "sellerId": { "type": "string" },
        "sellerName": { "type": "string" },
        "originCountry": { "type": "string" },
        "isOrganic": { "boolean": "boolean" },
        "image": { "type": "string" },
        "rating": { "type": "number" },
        "reviewCount": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "draft", "out_of_stock"] },
        "lowStockThreshold": { "type": "number", "description": "Alert seller when stock hits this level." },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "sellerId", "price"]
    },
    "Notification": {
      "title": "System Notification",
      "description": "Alerts for sellers, developers, and customers.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "type": { "type": "string", "enum": ["low_stock", "order_received", "system", "platform_commission", "payment_success", "developer_notice", "payout_ready", "crop_doctor_update", "subscription_renewal_reminder", "subscription_activated", "subscription_payment_failed", "subscription_renewed", "subscription_expired"] },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "productId": { "type": "string" },
        "orderId": { "type": "string" },
        "subscriptionId": { "type": "string" },
        "amount": { "type": "number" },
        "upiId": { "type": "string" },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "message", "type"]
    },
    "Order": {
      "title": "Customer Order",
      "description": "Record of a purchase transaction.",
      "type": "object",
      "properties": {
        "customerId": { "type": "string" },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "productId": { "type": "string" },
              "name": { "type": "string" },
              "price": { "type": "number" },
              "quantity": { "type": "number" },
              "sellerId": { "type": "string" }
            }
          }
        },
        "totalAmount": { "type": "number" },
        "commissionAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "confirmed", "shipped", "delivered", "cancelled"] },
        "shippingAddress": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "SubscriptionPlan": {
      "title": "Subscription Plan",
      "description": "Configurable service tiers (1 month, 3 months, 6 months, 12 months, Lifetime) with pricing and renewal rules.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "serviceName": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "currency": { "type": "string" },
        "billingInterval": { "type": "string", "enum": ["1_month", "3_months", "6_months", "12_months", "lifetime"] },
        "validityDays": { "type": "number" },
        "trialPeriodDays": { "type": "number" },
        "autoRenewEligible": { "type": "boolean" },
        "manualRenewOption": { "type": "boolean" },
        "cancellationPolicy": { "type": "string" },
        "refundPolicy": { "type": "string" },
        "taxPercentage": { "type": "number" },
        "applicationFee": { "type": "number" },
        "renewablePrice": { "type": "number" },
        "promoDiscountPrice": { "type": "number" },
        "features": { "type": "array", "items": { "type": "string" } },
        "usageLimits": { "type": "object" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "serviceName", "price", "billingInterval", "validityDays"]
    },
    "CustomerSubscription": {
      "title": "Customer Subscription",
      "description": "Active, renewing, or expired customer membership with validity tracking and authorization.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "customerName": { "type": "string" },
        "customerEmail": { "type": "string" },
        "planId": { "type": "string" },
        "planName": { "type": "string" },
        "serviceName": { "type": "string" },
        "status": { "type": "string", "enum": ["trial", "active", "grace_period", "suspended", "cancelled", "expired"] },
        "startDate": { "type": "string", "format": "date-time" },
        "validityDays": { "type": "number" },
        "nextBillingDate": { "type": "string", "format": "date-time" },
        "expirationDate": { "type": "string", "format": "date-time" },
        "gracePeriodEndsAt": { "type": "string", "format": "date-time" },
        "autoRenewAuthorized": { "type": "boolean" },
        "paymentMethod": { "type": "string", "enum": ["UPI", "RAZORPAY", "CARD"] },
        "paymentMethodDetails": { "type": "string" },
        "autoRenewAttempts": { "type": "number" },
        "lastPaymentId": { "type": "string" },
        "cancellationRequested": { "type": "boolean" },
        "cancellationReason": { "type": "string" },
        "cancellationConsequencesAcknowledged": { "type": "boolean" },
        "renewalReminderPreferences": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "planId", "status", "startDate", "expirationDate"]
    },
    "SubscriptionPayment": {
      "title": "Subscription Payment Record",
      "description": "Ledger of subscription activations, manual renewals, and auto-renew transactions.",
      "type": "object",
      "properties": {
        "subscriptionId": { "type": "string" },
        "customerId": { "type": "string" },
        "customerEmail": { "type": "string" },
        "planId": { "type": "string" },
        "amount": { "type": "number" },
        "currency": { "type": "string" },
        "taxAmount": { "type": "number" },
        "totalAmount": { "type": "number" },
        "paymentProvider": { "type": "string", "enum": ["UPI", "RAZORPAY"] },
        "upiId": { "type": "string" },
        "utrNumber": { "type": "string" },
        "razorpayPaymentId": { "type": "string" },
        "razorpayOrderId": { "type": "string" },
        "status": { "type": "string", "enum": ["success", "failed", "refunded", "pending"] },
        "failureReason": { "type": "string" },
        "invoiceNumber": { "type": "string" },
        "receiptUrl": { "type": "string" },
        "isRenewal": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["subscriptionId", "customerId", "amount", "status", "paymentProvider"]
    },
    "SubscriptionEmailTemplate": {
      "title": "Subscription Email Template",
      "description": "Configurable reminder and transactional email templates.",
      "type": "object",
      "properties": {
        "templateKey": { "type": "string" },
        "name": { "type": "string" },
        "subject": { "type": "string" },
        "bodyHtml": { "type": "string" },
        "bodyText": { "type": "string" },
        "isTransactional": { "type": "boolean" },
        "variables": { "type": "array", "items": { "type": "string" } },
        "active": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["templateKey", "name", "subject", "bodyText"]
    },
    "SubscriptionCoupon": {
      "title": "Subscription Promo Coupon",
      "description": "Discount codes applicable to subscriptions.",
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "discountPercent": { "type": "number" },
        "discountAmount": { "type": "number" },
        "validUntil": { "type": "string", "format": "date-time" },
        "maxRedemptions": { "type": "number" },
        "timesRedeemed": { "type": "number" },
        "active": { "type": "boolean" },
        "planIds": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["code", "active"]
    },
    "SubscriptionAuditLog": {
      "title": "Subscription Audit Log",
      "description": "Audit trail for all lifecycle actions.",
      "type": "object",
      "properties": {
        "action": { "type": "string" },
        "actorId": { "type": "string" },
        "actorEmail": { "type": "string" },
        "targetSubscriptionId": { "type": "string" },
        "details": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["action", "actorId", "createdAt"]
    },
    "Settings": {
      "title": "Platform Settings",
      "description": "Global configuration for the FreshWorld platform.",
      "type": "object",
      "properties": {
        "defaultCommissionRate": { "type": "number" },
        "lastUpdatedBy": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "CropDiagnostic": {
      "title": "Crop Disease Diagnostic",
      "description": "AI analysis of crop produce photos for diseases and quality issues.",
      "type": "object",
      "properties": {
        "sellerId": { "type": "string" },
        "imageUrl": { "type": "string" },
        "cropName": { "type": "string" },
        "overallHealth": { "type": "string" },
        "healthScore": { "type": "number" },
        "diagnosedIssues": { "type": "array" },
        "mitigationStrategies": { "type": "array" },
        "qualityGrade": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["sellerId", "cropName", "overallHealth"]
    },
    "Review": {
      "title": "Product Review",
      "description": "Ratings and feedback left by customers on marketplace produce.",
      "type": "object",
      "properties": {
        "productId": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userPhoto": { "type": "string" },
        "rating": { "type": "number" },
        "comment": { "type": "string" },
        "verifiedPurchase": { "type": "boolean" },
        "freshnessRating": { "type": "number" },
        "packagingRating": { "type": "number" },
        "tasteRating": { "type": "number" },
        "helpfulCount": { "type": "number" },
        "helpfulUsers": { "type": "array", "items": { "type": "string" } },
        "images": { "type": "array", "items": { "type": "string" } },
        "sellerReply": {
          "type": "object",
          "properties": {
            "reply": { "type": "string" },
            "createdAt": { "type": "string", "format": "date-time" }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["productId", "userId", "userName", "rating", "comment"]
    }
  },
  "firestore": {
    "users": {
      "schema": "User",
      "description": "Public user metadata."
    },
    "sellers": {
      "schema": "Seller",
      "description": "Detailed seller profiles (admin approved)."
    },
    "products": {
      "schema": "Product",
      "description": "Global marketplace product listings."
    },
    "reviews": {
      "schema": "Review",
      "description": "Customer reviews and star ratings for produce."
    },
    "orders": {
      "schema": "Order",
      "description": "Order history for buyers and sellers."
    },
    "notifications": {
      "schema": "Notification",
      "description": "In-app alerts for users."
    },
    "cropDiagnostics": {
      "schema": "CropDiagnostic",
      "description": "AI crop health diagnostic reports for farmers."
    },
    "settings": {
      "schema": "Settings",
      "description": "Global platform settings (Admin only)."
    },
    "subscriptionPlans": {
      "schema": "SubscriptionPlan",
      "description": "Available subscription and validity tiers."
    },
    "customerSubscriptions": {
      "schema": "CustomerSubscription",
      "description": "Customer active and expired subscriptions."
    },
    "subscriptionPayments": {
      "schema": "SubscriptionPayment",
      "description": "Payment transactions for subscriptions."
    },
    "subscriptionTemplates": {
      "schema": "SubscriptionEmailTemplate",
      "description": "Customizable reminder email templates."
    },
    "subscriptionCoupons": {
      "schema": "SubscriptionCoupon",
      "description": "Promotional discount codes for subscriptions."
    },
    "subscriptionAuditLogs": {
      "schema": "SubscriptionAuditLog",
      "description": "Audit trails for subscription lifecycle events."
    }
  }
}
